<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_backup_odometry</name>
  <version>1.0.0</version>
  <description>Tram backup odometry: longitudinal velocity and position of the tram from bogie
    wheel speeds and the driver controller position (no GNSS/IMU in the main loop). Publishes
    /result/velocity and /result/position, wheel-slip diagnostics in /diagnostics.</description>
  <maintainer email="ryffafyfi@gmail.com">Rafael</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tram_vehicle_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- numpy: карта в формате track_*.csv для альтернативного оценщика (track_csv.py); есть в ros-base -->
  <exec_depend>python3-numpy</exec_depend>
  <!-- только для инструмента fault_player -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
